#!/usr/bin/env python3

import os
import runpy
import sys

if __name__ == '__main__':
    # Ensure the project root is importable regardless of how we were invoked.
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    # Set a friendly program name while preserving any command-line arguments.
    sys.argv[0] = 'console-window-demo'
    # Run the demo module as __main__ so its "if __name__ == '__main__'" runs.
    runpy.run_module('ConsoleWindowDemo', run_name='__main__', alter_sys=True)
