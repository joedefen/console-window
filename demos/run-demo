#!/usr/bin/env python3
"""Run a sample app by its short name.

The demos live next to this script as ``demo-<name>.py``.  The short name is
the file's base name with the leading ``demo-`` and trailing ``.py`` removed,
so both of these launch ``demos/demo-buffet.py``::

    ./demos/run-demo buffet
    ./run-demo buffet                 # with demos/ on PATH, from demos/

Any remaining arguments are handed to the sample's own command line, and the
project root is put on ``sys.path`` first so ``console_window`` imports from
the working tree no matter which of those directories you invoke the runner
from.
"""

import os
import runpy
import sys

DEMO_PREFIX = 'demo-'
DEMO_SUFFIX = '.py'


def _demos_dir():
    return os.path.dirname(os.path.abspath(__file__))


def _available_demos(demos_dir):
    """Return the short names of every ``demo-*.py`` next to this script."""
    names = []
    for entry in os.listdir(demos_dir):
        if entry.startswith(DEMO_PREFIX) and entry.endswith(DEMO_SUFFIX):
            names.append(entry[len(DEMO_PREFIX):-len(DEMO_SUFFIX)])
    return sorted(names)


def _resolve(demos_dir, name):
    """Map a short name (or file name) to the sample script path, or None."""
    # Accept the base name with or without "demo-" and ".py", and never let a
    # path component escape the demos directory.
    name = os.path.basename(name)
    if name.endswith(DEMO_SUFFIX):
        name = name[:-len(DEMO_SUFFIX)]
    if name.startswith(DEMO_PREFIX):
        name = name[len(DEMO_PREFIX):]
    if not name:
        return None

    demo_path = os.path.join(demos_dir, DEMO_PREFIX + name + DEMO_SUFFIX)
    if os.path.isfile(demo_path):
        return demo_path

    # Allow the plain "<name>.py" spelling too, for demos that do not use the
    # demo- prefix (for instance PrimeRows.py).
    plain_path = os.path.join(demos_dir, name + DEMO_SUFFIX)
    if os.path.isfile(plain_path):
        return plain_path
    return None


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    demos_dir = _demos_dir()
    project_root = os.path.dirname(demos_dir)

    # The sample imports the library, not the other way around.  Inserting the
    # project root keeps `import console_window` working when run from demos/
    # (where the current directory is demos/, not the project root).
    if project_root not in sys.path:
        sys.path.insert(0, project_root)

    if not argv:
        demos = _available_demos(demos_dir)
        print('usage: run-demo <name> [sample arguments...]', file=sys.stderr)
        if demos:
            print('demos: ' + ', '.join(demos), file=sys.stderr)
        return 2

    name, sample_args = argv[0], argv[1:]
    path = _resolve(demos_dir, name)
    if path is None:
        demos = _available_demos(demos_dir)
        print('run-demo: no sample named {!r} in {}'.format(name, demos_dir),
              file=sys.stderr)
        if demos:
            print('demos: ' + ', '.join(demos), file=sys.stderr)
        return 2

    # Give the sample a friendly program name and pass its arguments through.
    # run_path() does not touch sys.argv, so the name we set here is the one
    # the sample sees.
    sys.argv = ['console-window-' + os.path.basename(path)[:-len(DEMO_SUFFIX)],
                *sample_args]
    runpy.run_path(path, run_name='__main__')
    return 0


if __name__ == '__main__':
    sys.exit(main())
